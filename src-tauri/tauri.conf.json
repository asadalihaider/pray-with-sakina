{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sakina",
  "version": "0.1.2",
  "identifier": "dev.asadalihaider.sakina",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Sakina",
        "width": 340,
        "height": 480,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVGN0UyNjRFMDE0OERGRDAKUldUUTMwZ0JUaVorWCs3eXEvS1FoUzdlRzZHdzF1cDBhU3JyTTlPNTkvaFMvblFHUFBVWFNweFcK",
      "endpoints": [
        "https://github.com/asadalihaider/pray-with-sakina/releases/latest/download/latest.json"
      ]
    }
  }
}
